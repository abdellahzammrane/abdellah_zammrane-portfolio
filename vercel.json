{
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "routes": [
    {
      "src": "/style.css",
      "dest": "/api/style.css"
    },
    {
      "src": "/script.js",
      "dest": "/api/script.js"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ]
}